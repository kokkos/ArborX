@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_package(Kokkos @ARBORX_KOKKOS_MINIMUM_REQUIRED_VERSION@ QUIET)
if(NOT Kokkos_FOUND)
  # If Kokkos was not found, try to use Kokkos used when building ArborX
  set(Kokkos_DIR @Kokkos_DIR@)
  find_dependency(Kokkos @ARBORX_KOKKOS_MINIMUM_REQUIRED_VERSION@)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ArborXSettings.cmake")
if(Kokkos_ENABLE_HIP AND ARBORX_ENABLE_ROCTHRUST)
  find_dependency(rocthrust)
endif()
if(Kokkos_ENABLE_SYCL AND ARBORX_ENABLE_ONEDPL)
  set(ARBORX_CXX_COMPILER_BUNDLED_ONEDPL @ARBORX_CXX_COMPILER_BUNDLED_ONEDPL@)
  if(NOT ARBORX_CXX_COMPILER_BUNDLED_ONEDPL)
    find_dependency(oneDPL)
  endif()
  unset(ARBORX_CXX_COMPILER_BUNDLED_ONEDPL)
endif()
if(ARBORX_ENABLE_MPI)
  find_dependency(MPI)
endif()
if(ARBORX_ENABLE_TRILINOS)
  # TribitsProjectWriteConfigFile.cmake in Trilinos sets COMPATIBILITY to SameMajorVersion.
  # Thus, we check the version post finding.
  find_dependency(Trilinos CONFIG COMPONENTS ${ARBORX_TRILINOS_COMPONENT_LIST})
  if (Trilinos_VERSION VERSION_LESS @ARBORX_TRILINOS_MINIMUM_VERSION@)
    set(ArborX_FOUND FALSE)
    set(ArborX_NOT_FOUND_MESSAGE "Arborx requires Trilinos @ARBORX_TRILINOS_MINIMUM_VERSION@ or newer")
    return()
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ArborXTargets.cmake")
check_required_components(ArborX)
